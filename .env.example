# Вариант Google AI Studio. Каталог проверяется при запуске.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Максимум последовательных запросов генерации в минуту для одного процесса.
GEMINI_REQUESTS_PER_MINUTE=10

# Для запуска через Codex CLI замените значения двух переменных выше:
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-6.2-sol
# CODEX_EXTRACT_WORKERS=2
